{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/upstream-first/evaluation-manifest.schema.json",
  "title": "Skill Evaluation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "skill", "cases"],
  "properties": {
    "manifest_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "skill": {
      "enum": ["upstream-first", "maintainer-ready-contribution", "ai-contribution-review"]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt",
          "expected_outcome",
          "required_behaviors",
          "forbidden_behaviors"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "prompt": {"type": "string", "minLength": 1},
          "expected_outcome": {
            "enum": ["pass", "revise", "ask-maintainer", "do-not-submit", "local-with-record"]
          },
          "required_behaviors": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "forbidden_behaviors": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
