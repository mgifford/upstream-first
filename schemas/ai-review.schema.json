{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/upstream-first/ai-review.schema.json",
  "title": "AI Contribution Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "project",
    "contribution_type",
    "known_ai_assistance",
    "policy",
    "human_accountability",
    "gates",
    "outcome",
    "human_approval_required"
  ],
  "properties": {
    "record_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "project": {"type": "string", "minLength": 1},
    "contribution_type": {
      "enum": ["code", "tests", "documentation", "issue", "pull-request", "review", "translation", "design", "other"]
    },
    "known_ai_assistance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known", "activities", "tool"],
      "properties": {
        "known": {"type": "boolean"},
        "activities": {"type": "array", "items": {"type": "string"}},
        "tool": {"type": ["string", "null"]}
      }
    },
    "policy": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "activity", "state", "requirement"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "activity": {"type": "string", "minLength": 1},
          "state": {
            "enum": [
              "prohibited",
              "restricted",
              "permitted-with-disclosure",
              "permitted-under-ordinary-rules",
              "unspecified",
              "conflicting"
            ]
          },
          "requirement": {"type": "string", "minLength": 1}
        }
      }
    },
    "human_accountability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_work_reviewed", "material_choices_understood", "claims_verified", "available_for_revision"],
      "properties": {
        "final_work_reviewed": {"type": "boolean"},
        "material_choices_understood": {"type": "boolean"},
        "claims_verified": {"type": "boolean"},
        "available_for_revision": {"type": "boolean"}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fit_scope",
        "correctness_tests",
        "accessibility",
        "security_privacy",
        "license_provenance",
        "standards_compatibility",
        "sustainability_review_burden",
        "disclosure"
      ],
      "properties": {
        "fit_scope": {"type": "string", "minLength": 1},
        "correctness_tests": {"type": "string", "minLength": 1},
        "accessibility": {"type": "string", "minLength": 1},
        "security_privacy": {"type": "string", "minLength": 1},
        "license_provenance": {"type": "string", "minLength": 1},
        "standards_compatibility": {"type": "string", "minLength": 1},
        "sustainability_review_burden": {"type": "string", "minLength": 1},
        "disclosure": {"type": "string", "minLength": 1}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "required_changes", "optional_suggestions", "open_questions"],
      "properties": {
        "decision": {
          "enum": ["pass", "revise", "ask-maintainer", "do-not-submit", "local-with-record"]
        },
        "required_changes": {"type": "array", "items": {"type": "string"}},
        "optional_suggestions": {"type": "array", "items": {"type": "string"}},
        "open_questions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "human_approval_required": {"const": true}
  }
}
