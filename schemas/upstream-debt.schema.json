{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mgifford/upstream-first/main/schemas/upstream-debt.schema.json",
  "title": "Upstream Debt Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "records"],
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "classification",
          "visibility",
          "locations",
          "owner",
          "reason",
          "upstream_reference",
          "exception_reason",
          "introduced_on",
          "review_by",
          "supported_versions",
          "removal_condition",
          "migration",
          "rollback",
          "status",
          "human_approval_required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UF-[0-9]{4,}$"
          },
          "classification": {
            "enum": [
              "temporary-workaround",
              "local-divergence",
              "security-mitigation"
            ]
          },
          "visibility": {
            "enum": ["public", "restricted"]
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "owner": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "upstream_reference": {
            "type": ["string", "null"]
          },
          "exception_reason": {
            "type": ["string", "null"]
          },
          "introduced_on": {
            "type": "string",
            "format": "date"
          },
          "review_by": {
            "type": "string",
            "format": "date"
          },
          "supported_versions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "removal_condition": {"type": "string", "minLength": 1},
          "migration": {"type": "string", "minLength": 1},
          "rollback": {"type": "string", "minLength": 1},
          "status": {
            "enum": [
              "active",
              "upstream-open",
              "upstream-accepted",
              "released",
              "blocked",
              "exception",
              "under-embargo",
              "overdue",
              "resolved"
            ]
          },
          "human_approval_required": {"const": true}
        }
      }
    }
  }
}
